# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lift

# JWT (en az 32 karakter)
JWT_SECRET=change-this-to-a-very-long-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (virgulle ayirarak birden fazla origin verilebilir)
CORS_ORIGIN=*

# Upload
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
