# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lift

# JWT (en az 32 karakter)
JWT_SECRET=change-this-to-a-very-long-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (virgulle ayirarak birden fazla origin verilebilir; cookie auth icin * yerine origin kullan)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Auth cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# Upload (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lift-uploads
S3_REGION=us-east-1
PUBLIC_BASE_URL=http://localhost:3000
